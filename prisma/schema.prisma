generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ======================================================
// CLIENTE
// ======================================================

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
}

// ======================================================
// BARBERO
// ======================================================

model Barber {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  schedules    BarberSchedule[]
  services     BarberService[]
}

// ======================================================
// SERVICIOS
// ======================================================

model Service {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  
  // Duración base en minutos
  duration    Int

  // Precio en pesos colombianos
  price       Int

  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
  barbers      BarberService[]
}

// ======================================================
// SERVICIOS QUE PUEDE REALIZAR CADA BARBERO
// ======================================================

model BarberService {
  id Int @id @default(autoincrement())

  barberId  Int
  serviceId Int

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([barberId, serviceId])
  @@index([barberId])
  @@index([serviceId])
}

// ======================================================
// HORARIOS DEL BARBERO
// ======================================================

model BarberSchedule {
  id Int @id @default(autoincrement())

  barberId Int

  // 0 = Domingo
  // 1 = Lunes
  // 2 = Martes
  // 3 = Miércoles
  // 4 = Jueves
  // 5 = Viernes
  // 6 = Sábado
  dayOfWeek Int

  // Minutos desde las 00:00
  // 8:00 AM = 480
  // 6:00 PM = 1080
  startMinute Int
  endMinute   Int

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, dayOfWeek])
}

// ======================================================
// CITAS
// ======================================================

model Appointment {
  id Int @id @default(autoincrement())

  clientId  Int
  barberId  Int
  serviceId Int

  // Guardaremos estos timestamps en UTC
  startTime DateTime @db.Timestamptz(3)
  endTime   DateTime @db.Timestamptz(3)

  status AppointmentStatus @default(CONFIRMED)

  // Detalles que diga el cliente:
  // "degradado bajo", "barba corta", etc.
  notes String?

  // Para saber si la cita vino de Vapi,
  // página web, recepción, etc.
  source String? @default("VAPI")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id])
  barber  Barber  @relation(fields: [barberId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@index([barberId, startTime])
  @@index([clientId])
  @@index([startTime])
  @@index([status])
}